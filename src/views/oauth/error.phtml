<?php
/**
 * What a person sees when a request cannot be sent back to the application that
 * made it — an unknown client, or a redirect URI that is not registered.
 *
 * @var string $error
 * @var string $description
 * @var string $service
 */
$e = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $e($service) ?></title>
</head>
<body class="oauth-error">
<main>
    <h1><?= $e($service) ?></h1>
    <p>That sign-in request cannot be completed.</p>
    <p><?= $e($description) ?></p>
    <p><small><?= $e($error) ?></small></p>
</main>
</body>
</html>
