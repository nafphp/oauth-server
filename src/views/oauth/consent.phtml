<?php

use Naf\OAuth\Server\Core\Consent;

/**
 * The consent screen.
 *
 * Copy this file to your application's view directory as oauth/consent.phtml to
 * change it. Yours wins, and nothing in the central configuration has to change.
 *
 * The hidden request id is the only thing that travels: the client, the scopes
 * and the redirect URI stay on the server, so nothing posted back here can
 * change what is being agreed to.
 *
 * @var Consent $consent
 * @var string $service Display name of this sign-in service.
 * @var string $csrf Bound to this one request, so parallel forms both work.
 */
$e = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
?>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $e($service) ?></title>
</head>
<body class="oauth-consent">
<main>
    <h1><?= $e($service) ?></h1>

    <p><strong><?= $e($consent->clientName) ?></strong> would like to act on your behalf.</p>

    <?php if ($consent->scopes !== []): ?>
        <p>It is asking to:</p>
        <ul>
            <?php foreach ($consent->scopes as $scope): ?>
                <li><?= $e($scope['label']) ?></li>
            <?php endforeach ?>
        </ul>
    <?php else: ?>
        <p>It is asking only to know who you are.</p>
    <?php endif ?>

    <form method="post" action="/oauth/authorize">
        <input type="hidden" name="_csrf" value="<?= $e($csrf) ?>">
        <input type="hidden" name="request_id" value="<?= $e($consent->requestId) ?>">
        <button type="submit" name="deny" value="1">Cancel</button>
        <button type="submit" name="approve" value="1">Allow</button>
    </form>
</main>
</body>
</html>
